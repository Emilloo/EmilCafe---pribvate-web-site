# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Admin Authentication (handled securely on Node.js server)
ADMIN_USERNAME="Emil"
ADMIN_PASSWORD="YOUR_ADMIN_PASSWORD"
ADMIN_SESSION_SECRET="YOUR_SESSION_SECRET_KEY"

# Email Delivery Configuration (Optional - for real SMTP email delivery)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="ismayilovemil1109@gmail.com"
SMTP_PASS="YOUR_GMAIL_APP_PASSWORD"
SMTP_FROM="EmilCafe <ismayilovemil1109@gmail.com>"

# Firebase Configuration (Optional - client & server Firebase integrations)
FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
FIREBASE_AUTH_DOMAIN="YOUR_PROJECT_ID.firebaseapp.com"
FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
FIREBASE_STORAGE_BUCKET="YOUR_PROJECT_ID.appspot.com"
FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
FIREBASE_APP_ID="YOUR_APP_ID"
